{
  "name": "Figlog",
  "id": "figlog-plugin",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma"],
  "permissions": ["currentuser", "activeusers"],
  "networkAccess": {
    "allowedDomains": [
      "https://*.supabase.co"
    ],
    "devAllowedDomains": [
      "http://localhost:5173",
      "https://localhost:5173"
    ],
    "reasoning": "Figlog requires Supabase for user authentication and data persistence. Localhost is used during development only."
  }
}